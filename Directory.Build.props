<Project>
  <!-- Gemeinsame Einstellungen aller Projekte (MIGRATIONSPLAN E4/E5). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Product>AndiGenerator.NET</Product>
    <Authors>Peter Buchmann (C#-Portierung); Original: Andreas Hofmann</Authors>
    <Copyright>Copyright (c) 2026 Peter Buchmann (Portierung); Copyright (c) 2017 ff. Andreas Hofmann (AndiGenerator); GPL-3.0-only</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <!-- Build-Ausgaben außerhalb von OneDrive halten -->
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <ArtifactsPath Condition="'$(LOCALAPPDATA)' != ''">$(LOCALAPPDATA)\AndiGenerator.NET\artifacts</ArtifactsPath>
    <!-- Unter WSL/Linux (tools/tests-wsl.sh) im Linux-Dateisystem, nicht im OneDrive-Ordner -->
    <ArtifactsPath Condition="'$(LOCALAPPDATA)' == '' and '$(HOME)' != ''">$(HOME)/.cache/andigenerator.net/artifacts</ArtifactsPath>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Analyzer (StyleCop, Sonar): Konfiguration in .editorconfig und stylecop.json; ihre Warnungen gelten wie alle als Fehler. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
  </ItemGroup>
</Project>
