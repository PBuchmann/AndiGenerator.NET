<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:AndiGenerator.Presentation"
        x:Class="AndiGenerator.UI.Pflichtspielzeitdialog"
        x:DataType="p:PflichtspielzeitdialogViewModel"
        Title="Pflichtspieltag"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
  <StackPanel Margin="24" Spacing="12">
    <Grid Classes="formular" ColumnDefinitions="180,200" RowDefinitions="Auto,Auto,Auto">
      <Grid.Styles>
        <Style Selector="Grid.formular > :is(Control)">
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Row="0" Text="von:" />
      <CalendarDatePicker Grid.Row="0" Grid.Column="1" SelectedDate="{Binding Von}" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" />
      <TextBlock Grid.Row="1" Text="bis:" />
      <CalendarDatePicker Grid.Row="1" Grid.Column="1" SelectedDate="{Binding Bis}" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" />
      <TextBlock Grid.Row="2" Text="Minimale Anzahl Spiele:" />
      <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static p:PflichtspielzeitdialogViewModel.Anzahlen}" SelectedItem="{Binding Anzahl}" MinWidth="80" />
    </Grid>
    <TextBlock Text="{Binding Meldung}" Classes="fehler" TextWrapping="Wrap" MaxWidth="380" HorizontalAlignment="Left" />
    <Border Classes="dialogfuss">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button x:Name="Abbrechen" Classes="gross" Content="Abbrechen" IsCancel="True" />
        <Button x:Name="Ok" Classes="gross primaer" Content="OK" IsDefault="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
