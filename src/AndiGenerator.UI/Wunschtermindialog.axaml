<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:AndiGenerator.Presentation"
        x:Class="AndiGenerator.UI.Wunschtermindialog"
        x:DataType="p:WunschterminDialogViewModel"
        Title="Wunschtermin"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
  <Window.Styles>
    <Style Selector="Grid.formular > :is(Control)">
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>
  <StackPanel Margin="24" Spacing="10" MinWidth="520">
    <TextBlock Text="{Binding Datum}" FontWeight="SemiBold" />
    <ComboBox ItemsSource="{x:Static p:WunschterminDialogViewModel.Arten}" SelectedIndex="{Binding Art}" MinWidth="300" />
    <StackPanel Spacing="10" IsVisible="{Binding IstHeimspiel}">
      <Grid Classes="formular" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto">
        <TextBlock Text="Uhrzeit:" />
        <TimePicker Grid.Column="1" SelectedTime="{Binding Uhrzeit}" ClockIdentifier="24HourClock" MinuteIncrement="5" />
        <TextBlock Grid.Row="1" Text="Ausweichtermin:" />
        <CheckBox Grid.Row="1" Grid.Column="1" Content="nur im Notfall einplanen" IsChecked="{Binding Ausweich}" />
      </Grid>
      <StackPanel Spacing="2">
        <TextBlock Text="Halle" FontWeight="SemiBold" Margin="0,6,0,0" />
        <Grid Classes="formular" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="Maximale Heimspiele:" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static p:WunschterminDialogViewModel.MaxSpieleAuswahl}" SelectedIndex="{Binding MaxSpiele}" MinWidth="160" />
          <TextBlock Grid.Row="1" Text="Spiellokal:" />
          <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <ComboBox ItemsSource="{x:Static p:WunschterminDialogViewModel.Spiellokale}" SelectedItem="{Binding Spiellokal}" MinWidth="80" />
            <TextBlock Text="leer: Standardspiellokal der Mannschaft" Foreground="{StaticResource Grau}" VerticalAlignment="Center" />
          </StackPanel>
        </Grid>
      </StackPanel>
      <StackPanel Spacing="2">
        <TextBlock Text="Heimkoppel/Doppelspieltag" FontWeight="SemiBold" Margin="0,6,0,0" />
        <Grid Classes="formular" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto">
          <TextBlock Text="Koppel/Doppelspieltag:" />
          <ComboBox Grid.Column="1" ItemsSource="{x:Static p:WunschterminDialogViewModel.Koppelarten}" SelectedIndex="{Binding Koppel}" MinWidth="320" />
          <TextBlock Grid.Row="1" Text="Priorität bei Koppel:" IsEnabled="{Binding PrioAktiv}" />
          <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{x:Static p:WunschterminDialogViewModel.Prioritaeten}" SelectedIndex="{Binding Prio}" IsEnabled="{Binding PrioAktiv}" MinWidth="120" />
          <TextBlock Grid.Row="2" Text="Startzeit zweites Spiel:" IsEnabled="{Binding KoppelzeitAktiv}" />
          <TimePicker Grid.Row="2" Grid.Column="1" SelectedTime="{Binding Koppelzeit}" IsEnabled="{Binding KoppelzeitAktiv}" ClockIdentifier="24HourClock" MinuteIncrement="5" />
        </Grid>
      </StackPanel>
      <StackPanel Spacing="2">
        <TextBlock Text="Auswärtskoppeloptionen" FontWeight="SemiBold" Margin="0,6,0,0" />
        <Grid Classes="formular" ColumnDefinitions="170,*" RowDefinitions="Auto,Auto">
          <TextBlock Text="Auswärtskoppel:" IsEnabled="{Binding AuswaertskoppelMoeglich}" />
          <CheckBox Grid.Column="1" Content="Startzeit ändern um Auswärtskoppeltermine zu ermöglichen" IsChecked="{Binding Auswaertskoppel}" IsEnabled="{Binding AuswaertskoppelMoeglich}" />
          <TextBlock Grid.Row="1" Text="Alternative Startzeit:" IsEnabled="{Binding Auswaertskoppel}" />
          <TimePicker Grid.Row="1" Grid.Column="1" SelectedTime="{Binding Auswaertszeit}" IsEnabled="{Binding Auswaertskoppel}" ClockIdentifier="24HourClock" MinuteIncrement="5" />
        </Grid>
      </StackPanel>
    </StackPanel>
    <TextBlock Text="{Binding Meldung}" Classes="fehler" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
    <Border Classes="dialogfuss">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button x:Name="Abbrechen" Classes="gross" Content="Abbrechen" IsCancel="True" />
        <Button x:Name="Ok" Classes="gross primaer" Content="OK" IsDefault="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
