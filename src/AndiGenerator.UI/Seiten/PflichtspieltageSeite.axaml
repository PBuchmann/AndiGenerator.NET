<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:AndiGenerator.Presentation"
             xmlns:ui="using:AndiGenerator.UI"
             x:Class="AndiGenerator.UI.Seiten.PflichtspieltageSeite"
             x:DataType="p:PflichtspieltageSeiteViewModel">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Classes="erklaerung" Text="{x:Static p:PflichtspieltageSeiteViewModel.Erklaerung}" TextWrapping="Wrap" Margin="0,0,0,12" />
    <StackPanel DockPanel.Dock="Right" Spacing="6" Margin="12,0,0,0">
      <Button Command="{Binding NeuCommand}" MinWidth="150" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolPlus}" Groesse="18" />
          <TextBlock Text="Neu…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Command="{Binding BearbeitenCommand}" MinWidth="150" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolKalender}" Groesse="18" />
          <TextBlock Text="Bearbeiten…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Command="{Binding LoeschenCommand}" MinWidth="150" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolLoeschen}" Groesse="18" />
          <TextBlock Text="Löschen" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
    <Grid DockPanel.Dock="Top" ColumnDefinitions="320,*" Margin="10,0,0,4">
      <TextBlock Classes="spaltenkopf" Text="ZEITRAUM" />
      <TextBlock Grid.Column="1" Classes="spaltenkopf" Text="ANZAHL SPIELE" />
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="Keine Pflichtspieltermine vorhanden" IsVisible="{Binding Keine}" Classes="leer" Margin="10,4" />
    <ListBox x:Name="Liste" ItemsSource="{Binding Zeilen}" SelectedItem="{Binding Auswahl}" MinHeight="200">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="p:PflichtspielzeitZeile">
          <Grid ColumnDefinitions="310,*">
            <TextBlock Text="{Binding Bezeichnung}" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" MinWidth="80" ItemsSource="{x:Static p:PflichtspielzeitZeile.Anzahlen}" SelectedItem="{Binding Anzahl}" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
