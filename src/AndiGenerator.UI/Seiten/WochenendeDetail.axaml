<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:AndiGenerator.Presentation"
             x:Class="AndiGenerator.UI.Seiten.WochenendeDetail"
             x:DataType="p:WochenendeDetailViewModel">
  <StackPanel Spacing="8" HorizontalAlignment="Left">
    <TextBlock Classes="leer" Text="{x:Static p:WochenendeDetailViewModel.Entfernungserklaerung}" TextWrapping="Wrap" MaxWidth="560" IsVisible="{Binding HatEntfernungen}" />
    <TextBlock Classes="leer" Text="{x:Static p:WochenendeDetailViewModel.OhneEntfernungen}" TextWrapping="Wrap" MaxWidth="560" IsVisible="{Binding !HatEntfernungen}" />
    <ItemsControl ItemsSource="{Binding Gegner}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="p:Gegnerzeile">
          <Grid ColumnDefinitions="280,64,Auto" Margin="0,1">
            <CheckBox Content="{Binding Name}" IsChecked="{Binding Gewaehlt}" />
            <TextBlock Grid.Column="1" Text="{Binding Entfernung}" Classes="ziffer" Foreground="{StaticResource Tinte2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            <Border Grid.Column="2" IsVisible="{Binding HatHinweis}" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" Background="{StaticResource AkzentHell}" VerticalAlignment="Center">
              <TextBlock Text="{Binding Hinweis}" FontSize="12" Foreground="{StaticResource AkzentDunkel}" />
            </Border>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Border IsVisible="{Binding HatEntfernungen}" BorderBrush="{StaticResource Tinte2}" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
      <Grid ColumnDefinitions="280,64,Auto">
        <TextBlock Text="{Binding GesamtText}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="28,0,0,0" />
        <TextBlock Grid.Column="1" Text="{Binding Gesamt}" Classes="ziffer" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
