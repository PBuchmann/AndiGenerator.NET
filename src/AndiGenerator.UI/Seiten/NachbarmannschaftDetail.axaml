<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:AndiGenerator.Presentation"
             xmlns:ui="using:AndiGenerator.UI"
             xmlns:a="using:AndiGenerator.Application"
             x:Class="AndiGenerator.UI.Seiten.NachbarmannschaftDetail"
             x:DataType="p:NachbarmannschaftDetailViewModel">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Classes="abschnitt" Text="Nachbarmannschaften" />
    <StackPanel DockPanel.Dock="Right" Spacing="6" Margin="12,0,0,0">
      <Button Command="{Binding NeuCommand}" MinWidth="210" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolPlus}" Groesse="18" />
          <TextBlock Text="Neue Mannschaft…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Command="{Binding BearbeitenCommand}" MinWidth="210" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolNachbarn}" Groesse="18" />
          <TextBlock Text="Mannschaft bearbeiten…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Command="{Binding LoeschenCommand}" MinWidth="210" HorizontalContentAlignment="Left">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolLoeschen}" Groesse="18" />
          <TextBlock Text="Mannschaft löschen…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
    <ListBox x:Name="Liste" ItemsSource="{Binding Eintraege}" SelectedItem="{Binding Auswahl}" MinHeight="260">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="a:Nachbarmannschaftseintrag">
          <TextBlock Text="{Binding Bezeichnung}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
