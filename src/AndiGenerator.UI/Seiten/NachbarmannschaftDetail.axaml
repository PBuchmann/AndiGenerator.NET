<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:AndiGenerator.Presentation"
             xmlns:ui="using:AndiGenerator.UI"
             xmlns:a="using:AndiGenerator.Application"
             x:Class="AndiGenerator.UI.Seiten.NachbarmannschaftDetail"
             x:DataType="p:NachbarmannschaftDetailViewModel">
  <DockPanel HorizontalAlignment="Stretch" MaxWidth="756">
    <TextBlock DockPanel.Dock="Top" Classes="abschnitt" Text="Nachbarmannschaften" />
    <StackPanel DockPanel.Dock="Right" Classes="seitenknoepfe">
      <Button Classes="seitenknopf" Command="{Binding NeuCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolPlus}" Groesse="18" />
          <TextBlock Text="Neue Mannschaft…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="seitenknopf" Command="{Binding BearbeitenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolNachbarn}" Groesse="18" />
          <TextBlock Text="Mannschaft bearbeiten…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="seitenknopf" Command="{Binding LoeschenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolLoeschen}" Groesse="18" />
          <TextBlock Text="Mannschaft löschen…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
    <ListBox x:Name="Liste" ItemsSource="{Binding Eintraege}" SelectedItem="{Binding Auswahl}" MinHeight="260" MinWidth="200">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="a:Nachbarmannschaftseintrag">
          <TextBlock Text="{Binding Bezeichnung}" TextWrapping="Wrap" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
