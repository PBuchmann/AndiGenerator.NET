<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:p="using:AndiGenerator.Presentation"
             xmlns:ui="using:AndiGenerator.UI"
             x:Class="AndiGenerator.UI.Seiten.MannschaftenSeite"
             x:DataType="p:MannschaftenSeiteViewModel">
  <DockPanel Margin="12" HorizontalAlignment="Left">
    <StackPanel DockPanel.Dock="Right" Classes="seitenknoepfe">
      <Button Classes="seitenknopf" Command="{Binding NeuCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolPlus}" Groesse="18" />
          <TextBlock Text="Neu…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="seitenknopf" Command="{Binding BearbeitenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolDaten}" Groesse="18" />
          <TextBlock Text="Bearbeiten…" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Classes="seitenknopf" Command="{Binding LoeschenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ui:Symbol Daten="{StaticResource SymbolLoeschen}" Groesse="18" />
          <TextBlock Text="Löschen" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
    <ListBox x:Name="Liste" ItemsSource="{Binding Namen}" SelectedItem="{Binding Auswahl}" MinHeight="300" Width="520" />
  </DockPanel>
</UserControl>
