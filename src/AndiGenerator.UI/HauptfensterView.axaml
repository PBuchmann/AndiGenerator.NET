<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:AndiGenerator.Presentation"
        xmlns:ui="using:AndiGenerator.UI"
        xmlns:dock="using:Dock.Avalonia.Controls"
        x:Class="AndiGenerator.UI.HauptfensterView"
        x:DataType="p:HauptfensterViewModel"
        Title="{Binding Titel}"
        Width="1440" Height="900" MinWidth="720" MinHeight="560"
        Background="{StaticResource Grund}"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Window.KeyBindings>
    <!-- Zoom der aktiven Ansicht wie im Browser; Haupttastatur und Ziffernblock. -->
    <KeyBinding Gesture="F1" Command="{Binding FuehrungCommand}" />
    <KeyBinding Gesture="Ctrl+OemPlus" Command="{Binding ZoomGroesserCommand}" />
    <KeyBinding Gesture="Ctrl+Add" Command="{Binding ZoomGroesserCommand}" />
    <KeyBinding Gesture="Ctrl+OemMinus" Command="{Binding ZoomKleinerCommand}" />
    <KeyBinding Gesture="Ctrl+Subtract" Command="{Binding ZoomKleinerCommand}" />
    <KeyBinding Gesture="Ctrl+D0" Command="{Binding ZoomZuruecksetzenCommand}" />
    <KeyBinding Gesture="Ctrl+NumPad0" Command="{Binding ZoomZuruecksetzenCommand}" />
    <!-- Auf dem Mac mit der Befehlstaste (⌘); unter Windows fängt das System Win+Plus/Minus selbst ab. -->
    <KeyBinding Gesture="Meta+OemPlus" Command="{Binding ZoomGroesserCommand}" />
    <KeyBinding Gesture="Meta+Add" Command="{Binding ZoomGroesserCommand}" />
    <KeyBinding Gesture="Meta+OemMinus" Command="{Binding ZoomKleinerCommand}" />
    <KeyBinding Gesture="Meta+Subtract" Command="{Binding ZoomKleinerCommand}" />
    <KeyBinding Gesture="Meta+D0" Command="{Binding ZoomZuruecksetzenCommand}" />
    <KeyBinding Gesture="Meta+NumPad0" Command="{Binding ZoomZuruecksetzenCommand}" />
  </Window.KeyBindings>
  <Window.Styles>
    <Style Selector="TextBlock.gut">
      <Setter Property="Foreground" Value="{StaticResource Gut}" />
    </Style>
    <Style Selector="TextBlock.schlecht">
      <Setter Property="Foreground" Value="{StaticResource Schlecht}" />
    </Style>
    <Style Selector="Button.kachel">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="200" />
      <Setter Property="Padding" Value="28" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="Background" Value="{StaticResource Flaeche}" />
      <Setter Property="BorderBrush" Value="{StaticResource Linie}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.kachel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Flaeche}" />
      <Setter Property="BorderBrush" Value="{StaticResource Akzent}" />
    </Style>
    <!-- Anpassung an die Fenstergröße (Klassen „eng“ und „niedrig“, siehe Code): Kacheln 2 × 2 bzw. kompakt. -->
    <Style Selector="Border.kopf">
      <Setter Property="Padding" Value="28,16" />
    </Style>
    <!-- Knöpfe im Kopf etwas schmaler, damit der Name der Staffel mehr Platz hat -->
    <Style Selector="Border.kopf Button.gross">
      <Setter Property="Padding" Value="14,0" />
    </Style>
    <Style Selector="Window.niedrig Border.kopf">
      <Setter Property="Padding" Value="20,8" />
    </Style>
    <Style Selector="TextBlock.titel">
      <Setter Property="FontSize" Value="24" />
    </Style>
    <Style Selector="Window.niedrig TextBlock.titel">
      <Setter Property="FontSize" Value="18" />
    </Style>
    <!-- Kacheln auf 24 Spalten: Ergebnis, Pflichtregeln, Verbesserungen, berechnete Pläne je sechs. Im Automodus entfällt die
         Kachel der Pflichtregeln (die Verstöße stehen in der Ergebniskachel): Ergebnis sechs, Verbesserungen fünf, berechnete
         Pläne mit HiGHS dreizehn. Im engen Fenster zwei Zeilen. -->
    <Style Selector="Grid.kacheln > Button.ergebnis">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="6" />
    </Style>
    <Style Selector="Grid.kacheln > Button.pflichtkachel">
      <Setter Property="Grid.Column" Value="6" />
      <Setter Property="Grid.ColumnSpan" Value="6" />
    </Style>
    <Style Selector="Grid.kacheln > Button.verbesserungen">
      <Setter Property="Grid.Column" Value="12" />
      <Setter Property="Grid.ColumnSpan" Value="6" />
    </Style>
    <Style Selector="Grid.kacheln > Button.plaene">
      <Setter Property="Grid.Column" Value="18" />
      <Setter Property="Grid.ColumnSpan" Value="6" />
    </Style>
    <Style Selector="Grid.kacheln.automodus > Button.verbesserungen">
      <Setter Property="Grid.Column" Value="6" />
      <Setter Property="Grid.ColumnSpan" Value="5" />
    </Style>
    <Style Selector="Grid.kacheln.automodus > Button.plaene">
      <Setter Property="Grid.Column" Value="11" />
      <Setter Property="Grid.ColumnSpan" Value="13" />
    </Style>
    <Style Selector="Window.eng Grid.kacheln > Button.ergebnis">
      <Setter Property="Grid.ColumnSpan" Value="12" />
    </Style>
    <Style Selector="Window.eng Grid.kacheln > Button.pflichtkachel">
      <Setter Property="Grid.Column" Value="12" />
      <Setter Property="Grid.ColumnSpan" Value="12" />
    </Style>
    <Style Selector="Window.eng Grid.kacheln > Button.verbesserungen">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="12" />
    </Style>
    <Style Selector="Window.eng Grid.kacheln > Button.plaene">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="12" />
      <Setter Property="Grid.ColumnSpan" Value="12" />
    </Style>
    <Style Selector="Window.eng Grid.kacheln.automodus > Button.verbesserungen">
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.Column" Value="12" />
      <Setter Property="Grid.ColumnSpan" Value="12" />
    </Style>
    <Style Selector="Window.eng Grid.kacheln.automodus > Button.plaene">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="24" />
    </Style>
    <!-- Ohne HiGHS (Kostenoptimierung) nimmt der Teil „Berechnete Pläne“ die ganze Kachel ein -->
    <Style Selector="Grid.plaeneinhalt:not(.mithighs) > StackPanel.plaenelinks">
      <Setter Property="Grid.ColumnSpan" Value="3" />
    </Style>
    <Style Selector="Button.variantenknopf">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="{StaticResource AkzentHell}" />
      <Setter Property="Foreground" Value="{StaticResource AkzentDunkel}" />
    </Style>
    <Style Selector="TextBlock.klein.highs">
      <Setter Property="Foreground" Value="{StaticResource HighsDunkel}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Punktreihe der Schritte von HiGHS: fertig gefüllt, gerade dran mit Ring, noch offen hell -->
    <Style Selector="Ellipse.highsschritt">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="#E4E1DA" />
    </Style>
    <Style Selector="Ellipse.highsschritt.fertig">
      <Setter Property="Fill" Value="{StaticResource Highs}" />
    </Style>
    <Style Selector="Ellipse.highsschritt.aktiv">
      <Setter Property="Width" Value="10" />
      <Setter Property="Height" Value="10" />
      <Setter Property="Fill" Value="{StaticResource HighsHell}" />
      <Setter Property="Stroke" Value="{StaticResource Highs}" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.wert">
      <Setter Property="FontSize" Value="26" />
    </Style>
    <Style Selector="TextBlock.pflicht">
      <Setter Property="FontSize" Value="20" />
    </Style>
    <Style Selector="Window.niedrig TextBlock.wert">
      <Setter Property="FontSize" Value="18" />
    </Style>
    <Style Selector="Window.niedrig TextBlock.pflicht">
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="Window.niedrig TextBlock.hinweis, Window.niedrig Grid.hinweis">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="Button.kartenknopf">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
      <Setter Property="Padding" Value="18,14" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="{StaticResource Flaeche}" />
      <Setter Property="BorderBrush" Value="{StaticResource Linie}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.kartenknopf:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Flaeche}" />
      <Setter Property="BorderBrush" Value="{StaticResource Akzent}" />
    </Style>
    <Style Selector="Button.kartenknopf:disabled /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Flaeche}" />
      <Setter Property="BorderBrush" Value="{StaticResource Linie}" />
    </Style>
    <Style Selector="Window.niedrig Button.kartenknopf">
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Window.niedrig Border.karte">
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="Button.zuletzt">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="64" />
      <Setter Property="Padding" Value="18,8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.zuletzt:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Schwebe}" />
    </Style>
    <Style Selector="Button.entfernen">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{StaticResource Grau}" />
      <Setter Property="Margin" Value="4,0,6,0" />
    </Style>
    <Style Selector="Button.entfernen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{StaticResource Schwebe}" />
      <Setter Property="Foreground" Value="{StaticResource Schlecht}" />
    </Style>
  </Window.Styles>
  <Panel>
  <DockPanel>
    <!-- Navigation links; bei schmalem Fenster nur Symbole (Klasse „schmal“, siehe Code). -->
    <Border x:Name="Navigation" Classes="navigation" DockPanel.Dock="Left" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,1,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="16,16,16,4">
          <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Akzent}">
            <ui:Symbol Daten="{StaticResource SymbolLogo}" Farbe="White" Groesse="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <StackPanel Classes="logotext" VerticalAlignment="Center">
            <TextBlock Text="AndiGenerator.NET" FontWeight="Bold" FontSize="14" />
            <TextBlock Text="Spielplan-Generator" Classes="klein" FontSize="11" />
          </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="12,4,12,14">
          <Button Classes="nav" Classes.aktiv="{Binding ZeigtFuehrung}" Command="{Binding FuehrungCommand}" ToolTip.Tip="Schritt für Schritt durch die Optimierung (F1): zeigt nach und nach, was zu tun ist">
            <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolHilfe}" /><TextBlock Classes="navtext" Text="Schritt für Schritt" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding AnleitungCommand}" ToolTip.Tip="Anleitung als PDF öffnen">
            <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolAnleitung}" /><TextBlock Classes="navtext" Text="Anleitung" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding UeberCommand}" ToolTip.Tip="Über AndiGenerator.NET">
            <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolInfo}" /><TextBlock Classes="navtext" Text="Über" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="12,0">
            <ToggleButton x:Name="KopfStaffel" Classes="sektion" IsChecked="True" ToolTip.Tip="Abschnitt auf- oder zuklappen">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="STAFFEL" />
                <ui:Symbol Grid.Column="1" Classes="klappe" Daten="{StaticResource SymbolAuswahl}" Groesse="14" />
              </Grid>
            </ToggleButton>
            <StackPanel Classes="sektionsinhalt" Classes.zu="{Binding !#KopfStaffel.IsChecked}">
              <Button Classes="nav" Command="{Binding OeffnenCommand}" ToolTip.Tip="click-TT-Datei oder Plandatei öffnen">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolOeffnen}" /><TextBlock Classes="navtext" Text="Öffnen" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Command="{Binding NeuCommand}" ToolTip.Tip="Neue Datei zur komplett manuellen Eingabe erstellen">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolNeu}" /><TextBlock Classes="navtext" Text="Neu" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Command="{Binding DatenCommand}" ui:Fuehrungsmarke.Ziel="NavDaten" ToolTip.Tip="Spielplandaten bearbeiten">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolDaten}" /><TextBlock Classes="navtext" Text="Spielplandaten" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Einstellungen}" Command="{Binding EinstellungenCommand}" ui:Fuehrungsmarke.Ziel="NavEinstellungen" ToolTip.Tip="Einstellungen der Staffel">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolEinstellungen}" /><TextBlock Classes="navtext" Text="Einstellungen" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
            <ToggleButton x:Name="KopfAnsichten" Classes="sektion" IsChecked="True" ToolTip.Tip="Abschnitt auf- oder zuklappen">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="ANSICHTEN" />
                <ui:Symbol Grid.Column="1" Classes="klappe" Daten="{StaticResource SymbolAuswahl}" Groesse="14" />
              </Grid>
            </ToggleButton>
            <StackPanel Classes="sektionsinhalt" Classes.zu="{Binding !#KopfAnsichten.IsChecked}">
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Kompakt}" Command="{Binding KompaktspieltageCommand}" ui:Fuehrungsmarke.Ziel="NavKompakt" IsVisible="{Binding ZeigtKompaktspieltage}" ToolTip.Tip="Kompaktspieltage: Meldungen, Plan und Karte der Spielorte">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolKarte}" /><TextBlock Classes="navtext" Text="Kompaktspieltage" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Kosten}" IsVisible="{Binding ZeigtGenerierung}" Command="{Binding KostenansichtCommand}" ui:Fuehrungsmarke.Ziel="NavKosten" ToolTip.Tip="Kosten">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolKosten}" /><TextBlock Classes="navtext" Text="Kosten" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Qualitaet}" IsVisible="{Binding ZeigtGenerierung}" Command="{Binding QualitaetsansichtCommand}" ToolTip.Tip="Qualität" ui:Fuehrungsmarke.Ziel="NavQualitaet">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolQualitaet}" /><TextBlock Classes="navtext" Text="Qualität" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Meldungen}" IsVisible="{Binding ZeigtGenerierung}" Command="{Binding MeldungsansichtCommand}" ui:Fuehrungsmarke.Ziel="NavMeldungen" ToolTip.Tip="Meldungen je Mannschaft">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolMeldungen}" /><TextBlock Classes="navtext" Text="Meldungen" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Terminplan}" Command="{Binding TerminplanansichtCommand}" ToolTip.Tip="Terminplan">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolTerminplan}" /><TextBlock Classes="navtext" Text="Terminplan" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Diagramme}" Command="{Binding DiagrammansichtCommand}" ui:Fuehrungsmarke.Ziel="NavDiagramme" ToolTip.Tip="Diagramme">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolDiagramme}" /><TextBlock Classes="navtext" Text="Diagramme" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Terminwuensche}" Command="{Binding TerminwunschansichtCommand}" ToolTip.Tip="Terminwünsche">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolTerminwuensche}" /><TextBlock Classes="navtext" Text="Terminwünsche" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Classes.aktiv="{Binding AktiveAnsicht, Converter={x:Static ui:Konverter.Gleich}, ConverterParameter=Nachbarn}" Command="{Binding NachbarterminansichtCommand}" ToolTip.Tip="Nachbarmannschaften">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolNachbarn}" /><TextBlock Classes="navtext" Text="Nachbarmannschaften" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
            <ToggleButton x:Name="KopfAusgabe" Classes="sektion" IsChecked="True" ToolTip.Tip="Abschnitt auf- oder zuklappen">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="AUSGABE" />
                <ui:Symbol Grid.Column="1" Classes="klappe" Daten="{StaticResource SymbolAuswahl}" Groesse="14" />
              </Grid>
            </ToggleButton>
            <StackPanel Classes="sektionsinhalt" Classes.zu="{Binding !#KopfAusgabe.IsChecked}">
              <!-- Das Ergebnis der Arbeit: exportiert den gerade angezeigten Plan; farblich hervorgehoben, deaktiviert ohne Plan -->
              <Button Classes="nav hervorgehoben" Command="{Binding CsvExportierenCommand}" ui:Fuehrungsmarke.Ziel="NavExport" ToolTip.Tip="{Binding CsvHinweis}" ToolTip.ShowOnDisabled="True">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolExport}" /><TextBlock Classes="navtext" Text="Für click-TT exportieren" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="nav" Command="{Binding DruckenCommand}" ui:Fuehrungsmarke.Ziel="NavDrucken" ToolTip.Tip="Ausdruck als PDF-Datei">
                <StackPanel Orientation="Horizontal" Spacing="12"><ui:Symbol Daten="{StaticResource SymbolDrucken}" /><TextBlock Classes="navtext" Text="Drucken (PDF)" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Padding="16,4" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Linie}" Background="{StaticResource Flaeche}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding Statuszeile}" Classes="klein" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        <!-- Führung „Schritt für Schritt“: der nächste Schritt, der zur Lage passt; ein Klick öffnet die Begleitleiste -->
        <Button Grid.Column="1" Classes="link" Command="{Binding FuehrungCommand}" IsVisible="{Binding HatFuehrungsHinweis}" Margin="16,0,0,0" Padding="4,0"
                ToolTip.Tip="Schritt für Schritt öffnen (F1)">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <ui:Symbol Daten="{StaticResource SymbolHilfe}" Groesse="14" />
            <TextBlock Text="{Binding FuehrungsHinweis}" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- Begleitleiste „Schritt für Schritt“ -->
    <Panel DockPanel.Dock="Right" IsVisible="{Binding ZeigtFuehrung}">
      <ui:FuehrungLeiste DataContext="{Binding Fuehrung}" />
    </Panel>

    <Grid RowDefinitions="Auto,Auto,*">
      <!-- Kopf: Staffel und Steuerung der Generierung -->
      <Border Grid.Row="0" Classes="kopf" IsVisible="{Binding ZeigtArbeitsbereich}" Background="{StaticResource Flaeche}" BorderBrush="{StaticResource Linie}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,0,16,0">
            <TextBlock Text="{Binding Staffelinfo}" Classes="klein" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Staffelinfo}" />
            <TextBlock Text="{Binding Staffelname}" Classes="titel" FontWeight="Bold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Staffelname}" />
          </StackPanel>
          <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
            <StackPanel Spacing="4" Margin="0,0,8,0">
              <TextBlock Text="Start mit" Classes="klein" FontSize="11" />
              <ComboBox Classes="gross" MinWidth="170" ui:Fuehrungsmarke.Ziel="StartMit" MaxWidth="260" ItemsSource="{Binding Startplaene}" SelectedItem="{Binding Startplan}" IsEnabled="{Binding StartplanWaehlbar}"
                        ToolTip.Tip="Ausgangsplan für den nächsten Start. Eine laufende oder angehaltene Generierung setzt ihren eigenen besten Plan fort – für einen anderen Ausgangsplan zuerst „Stopp“."
                        ToolTip.ShowOnDisabled="True">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="p:Startplan">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>
            <!-- An derselben Stelle: „Plan merken“ während/nach der Generierung, „Plan löschen“ vor dem Start bei gewähltem gemerkten Plan -->
            <Panel VerticalAlignment="Bottom" Margin="0,0,16,0">
              <Button Classes="gross" Command="{Binding PlanMerkenCommand}" ui:Fuehrungsmarke.Ziel="PlanMerken" IsVisible="{Binding !ZeigtPlanLoeschen}" ToolTip.Tip="Besten Plan der Generierung unter einem Namen merken">
                <StackPanel Orientation="Horizontal" Spacing="10"><ui:Symbol Daten="{StaticResource SymbolMerken}" Groesse="20" /><TextBlock Text="Plan merken" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Classes="gross" Command="{Binding PlanLoeschenCommand}" IsVisible="{Binding ZeigtPlanLoeschen}" ToolTip.Tip="Den unter „Start mit“ gewählten gemerkten Plan endgültig löschen">
                <StackPanel Orientation="Horizontal" Spacing="10"><ui:Symbol Daten="{StaticResource SymbolLoeschen}" Groesse="20" /><TextBlock Text="Plan löschen" VerticalAlignment="Center" /></StackPanel>
              </Button>
            </Panel>
            <!-- Verfahren: zwei Optionsfelder nebeneinander, gestaltet wie die Umschalter der Ansichten (genau eines ist gewählt); vor dem Start wählen sie, während der Generierung wechseln sie -->
            <StackPanel Spacing="4" Margin="0,0,12,0" VerticalAlignment="Bottom" IsVisible="{Binding ZeigtGenerierung}">
              <TextBlock Text="Verfahren" Classes="klein" FontSize="11" />
              <Border Background="#ECEAE4" CornerRadius="12" Padding="4" ToolTip.Tip="{Binding VerfahrenErklaerung}" ui:Fuehrungsmarke.Ziel="Verfahren">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <RadioButton Classes="segment" GroupName="Verfahren" Content="Kostenoptimierung" IsChecked="{Binding KostenoptimierungGewaehlt}" IsEnabled="{Binding IstGeoeffnet}" />
                  <RadioButton Classes="segment" GroupName="Verfahren" Content="Automodus" IsChecked="{Binding AutomodusGewaehlt}" IsEnabled="{Binding IstGeoeffnet}" />
                </StackPanel>
              </Border>
            </StackPanel>
            <!-- Hauptknopf: Play vor dem Start, Pause während der Generierung, in der Pause „Fortsetzen“ (Strich und Play); rechts daneben vor dem Start
                 „Staffel schließen“ (✕), während der Generierung „Stopp“ (■) -->
            <Button Classes="gross primaer" Command="{Binding GenerierungCommand}" ui:Fuehrungsmarke.Ziel="Start" Width="56" Padding="0" HorizontalContentAlignment="Center" VerticalAlignment="Bottom"
                    ToolTip.Tip="{Binding GenerierungText}">
              <Panel>
                <ui:Symbol Daten="{StaticResource SymbolStart}" Gefuellt="True" Groesse="22" IsVisible="{Binding ZeigtStart}" />
                <ui:Symbol Daten="{StaticResource SymbolPause}" Gefuellt="True" Groesse="22" IsVisible="{Binding ZeigtPause}" />
                <ui:Symbol Daten="{StaticResource SymbolFortsetzen}" Gefuellt="True" Groesse="22" IsVisible="{Binding ZeigtFortsetzen}" />
              </Panel>
            </Button>
            <Panel VerticalAlignment="Bottom" Margin="8,0,0,0">
              <Button Classes="gross" Command="{Binding StoppenCommand}" ui:Fuehrungsmarke.Ziel="Stopp" IsVisible="{Binding ZeigtStopp}" Width="56" Padding="0" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Stopp: Generierung bzw. Planung der Kompaktspieltage beenden. Der bisher beste Plan bleibt erhalten.">
                <ui:Symbol Daten="{StaticResource SymbolStopp}" Gefuellt="True" Groesse="22" />
              </Button>
              <Button Classes="gross" Command="{Binding SchliessenCommand}" IsVisible="{Binding !ZeigtStopp}" Width="56" Padding="0" HorizontalContentAlignment="Center"
                      ToolTip.Tip="Staffel schließen und zur Startseite zurückkehren. Ein noch nicht gesicherter Plan wird vorher gesichert.">
                <ui:Symbol Daten="{StaticResource SymbolSchliessen}" Groesse="22" />
              </Button>
            </Panel>
          </WrapPanel>
        </Grid>
      </Border>

      <!-- Kacheln: Stand der Generierung (im Kompaktmodus ausgeblendet; die Kennzahlen stehen dort in der Ansicht) -->
      <Panel Grid.Row="1" IsVisible="{Binding ZeigtArbeitsbereich}">
      <Grid Classes="kacheln" ui:Fuehrungsmarke.Ziel="Kacheln" Classes.automodus="{Binding Anzeige.ZeigtVerstoesse}" IsVisible="{Binding ZeigtGenerierung}" Margin="22,10,22,0"
            ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*,*" RowDefinitions="Auto,Auto">
        <Button Classes="kartenknopf ergebnis" ui:Fuehrungsmarke.Ziel="KachelErgebnis" Margin="6" Command="{Binding ErgebnisCommand}" ToolTip.Tip="{Binding ErgebnisHinweis}">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Anzeige.Titel}" Classes="klein" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="Details ›" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" Margin="8,0,0,0" />
            </Grid>
            <!-- Kostenoptimierung: Gesamtkosten; Automodus: Verstöße der Stufen A, B und C (klein davor: am Ende der Basisoptimierung) -->
            <TextBlock Text="{Binding Anzeige.Kosten}" Classes="ziffer wert" IsVisible="{Binding !Anzeige.ZeigtVerstoesse}" />
            <!-- Passt die Zeile nicht in die Kachel (schmales Fenster, dreistellige Zahlen), wird sie kleiner statt abgeschnitten -->
            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" IsVisible="{Binding Anzeige.ZeigtVerstoesse}">
              <StackPanel Orientation="Horizontal" Spacing="28">
                <StackPanel Spacing="0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="A" Classes="klein" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Anzeige.BasisA}" Classes="klein ziffer" ToolTip.Tip="Verstöße am Ende der Basisoptimierung" />
                  </StackPanel>
                  <TextBlock Text="{Binding Anzeige.VerstossA}" Classes="ziffer wert" />
                </StackPanel>
                <StackPanel Spacing="0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="B" Classes="klein" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Anzeige.BasisB}" Classes="klein ziffer" ToolTip.Tip="Verstöße am Ende der Basisoptimierung" />
                  </StackPanel>
                  <TextBlock Text="{Binding Anzeige.VerstossB}" Classes="ziffer wert" />
                </StackPanel>
                <StackPanel Spacing="0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="C" Classes="klein" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Anzeige.BasisC}" Classes="klein ziffer" ToolTip.Tip="Verstöße am Ende der Basisoptimierung" />
                  </StackPanel>
                  <TextBlock Text="{Binding Anzeige.VerstossC}" Classes="ziffer wert" />
                </StackPanel>
              </StackPanel>
            </Viewbox>
            <TextBlock Text="{Binding Anzeige.KostenHinweis}" Classes="klein hinweis" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Anzeige.KostenHinweis, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <!-- Automodus: die Kriterien, deren Gewichte gerade angehoben werden (alle mit Namen) -->
            <TextBlock Classes="klein" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding Anzeige.Phase, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <Run Text="In Arbeit: " />
              <Run Text="{Binding Anzeige.Phase}" FontWeight="SemiBold" />
            </TextBlock>
          </StackPanel>
        </Button>
        <Button Classes="kartenknopf pflichtkachel" Margin="6" Command="{Binding QualitaetsansichtCommand}" IsVisible="{Binding !Anzeige.ZeigtVerstoesse}" ToolTip.Tip="Qualitätsansicht öffnen: welche Kriterien verletzt sind">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Pflichtregeln (Stufe A)" Classes="klein" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="Details ›" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" Margin="8,0,0,0" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8" MinHeight="30">
              <ui:Symbol Daten="{StaticResource SymbolHaken}" Farbe="{StaticResource Gut}" Groesse="24" VerticalAlignment="Center" IsVisible="{Binding Anzeige.PflichtErfuellt}" />
              <ui:Symbol Daten="{StaticResource SymbolWarnung}" Farbe="{StaticResource Schlecht}" Groesse="24" VerticalAlignment="Center" IsVisible="{Binding !Anzeige.PflichtErfuellt}" />
              <TextBlock Text="{Binding Anzeige.Pflicht}" Classes="pflicht" FontWeight="SemiBold" VerticalAlignment="Center"
                         Classes.gut="{Binding Anzeige.PflichtErfuellt}" Classes.schlecht="{Binding !Anzeige.PflichtErfuellt}" />
            </StackPanel>
            <TextBlock Text="{Binding Anzeige.PflichtHinweis}" Classes="klein hinweis" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="kartenknopf verbesserungen" ui:Fuehrungsmarke.Ziel="KachelVerlauf" Margin="6" Command="{Binding VerlaufCommand}" ToolTip.Tip="Verlauf der Suche öffnen: Kosten bzw. Verstöße seit dem Start">
          <StackPanel Spacing="2">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Verbesserungen" Classes="klein" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="Details ›" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" Margin="8,0,0,0" />
            </Grid>
            <!-- Rechts neben der Zahl der kleine Verlauf: Kosten bzw. Verstöße der wichtigsten Stufe, die noch welche hat -->
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding Anzeige.Verbesserungen}" Classes="ziffer wert" />
              <ui:Verlaufsdiagramm Grid.Column="1" Kompakt="True" Verlauf="{Binding Verlauf}" Version="{Binding Verlauf.Version}"
                                   MaxWidth="110" MinWidth="40" Height="30" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="16,0,0,0" />
            </Grid>
            <TextBlock Text="{Binding Anzeige.LetzteVerbesserung}" Classes="klein hinweis" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </Button>
        <Button Classes="kartenknopf plaene" ui:Fuehrungsmarke.Ziel="KachelLeitstand" Margin="6" Command="{Binding LeitstandCommand}" ToolTip.Tip="Leitstand öffnen: was die Rechenkerne, Inseln und HiGHS gerade tun">
          <!-- Links die berechneten Pläne und der Prozessor; im Automodus rechts daneben, woran HiGHS rechnet (Untergrenze bzw.
               Teilneuplanung), mit dem Knopf zu den B-Varianten -->
          <Grid ColumnDefinitions="5*,Auto,9*" Classes="plaeneinhalt" Classes.mithighs="{Binding Anzeige.ZeigtHighs}">
            <StackPanel Classes="plaenelinks" Spacing="2">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Berechnete Pläne" Classes="klein" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="Details ›" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" Margin="8,0,0,0"
                           IsVisible="{Binding !Anzeige.ZeigtHighs}" />
              </Grid>
              <TextBlock Text="{Binding Anzeige.Plaene}" Classes="ziffer wert" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding Anzeige.Tempo}" Classes="klein hinweis" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding Anzeige.Auslastung}" Classes="klein" Margin="8,0,0,0" />
              </Grid>
              <!-- Der ganze Prozessor wie im Leitstand: blau die Suche, orange HiGHS, grau andere Programme, hell frei; je Kern ein Strich -->
              <ui:Anteilsleiste Height="10" Margin="0,2,0,0" Kerne="{Binding Anzeige.Last.Prozessoren, FallbackValue=0}" Suche="{Binding Anzeige.Last.Suche, FallbackValue=0}"
                                Highs="{Binding Anzeige.Last.Highs, FallbackValue=0}" Rest="{Binding Anzeige.Last.Sonstiges, FallbackValue=0}"
                                ToolTip.Tip="Der ganze Prozessor: blau die Suche, orange HiGHS, grau andere Programme, hell frei – je Kern ein Strich" />
            </StackPanel>
            <Border Grid.Column="1" Width="1" Background="#E4E1DA" Margin="16,0" IsVisible="{Binding Anzeige.ZeigtHighs}" />
              <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding Anzeige.ZeigtHighs}">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Highs}" VerticalAlignment="Center" IsVisible="{Binding Anzeige.Highs.Rechnet, FallbackValue=False}" />
                    <TextBlock Text="{Binding Anzeige.Highs.Titel, FallbackValue={x:Null}}" Classes="klein" TextTrimming="CharacterEllipsis"
                               Classes.highs="{Binding Anzeige.Highs.Rechnet, FallbackValue=False}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="Details ›" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding Anzeige.Highs.Schritt, FallbackValue={x:Null}}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           Foreground="{StaticResource Tinte}" ToolTip.Tip="{Binding Anzeige.Highs.Schritt, FallbackValue={x:Null}}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Anzeige.Highs.Prozent, FallbackValue=0}" Height="6" MinHeight="6" CornerRadius="3" Margin="0,2"
                             Foreground="{StaticResource Highs}" Background="{StaticResource HighsHell}" IsVisible="{Binding Anzeige.Highs.ZeigtAnteil, FallbackValue=False}" />
                <!-- Zeit bzw. Erfolg, rechts daneben der Knopf zu den B-Varianten (wie in der Kopfzeile der Stufe B der Qualitätsansicht) -->
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="{Binding Anzeige.Highs.Zeit, FallbackValue={x:Null}}" Classes="klein hinweis" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                             ToolTip.Tip="{Binding Anzeige.Highs.Zeit, FallbackValue={x:Null}}" />
                  <Button Grid.Column="1" Classes="variantenknopf" ui:Fuehrungsmarke.Ziel="BVarianten" Content="{Binding Anzeige.Highs.VariantenText, FallbackValue={x:Null}}" Command="{Binding BVariantenCommand}"
                          IsVisible="{Binding Anzeige.Highs.ZeigtVarianten, FallbackValue=False}" Margin="8,0,0,0"
                          ToolTip.Tip="B-Varianten aus HiGHS vergleichen und eine wählen (wie in der Kopfzeile der Stufe B der Qualitätsansicht)" />
                </Grid>
                <!-- Die Schritte als Punkte und der nächste -->
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,2,0,0">
                  <ItemsControl ItemsSource="{Binding Anzeige.Highs.Schritte, FallbackValue={x:Null}}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="4" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="p:Highsschritt">
                        <Ellipse Classes="highsschritt" Classes.fertig="{Binding Fertig}" Classes.aktiv="{Binding Aktiv}" VerticalAlignment="Center" ToolTip.Tip="{Binding Hinweis}" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding Anzeige.Highs.Danach, FallbackValue={x:Null}}" Classes="klein hinweis" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
          </Grid>
        </Button>
      </Grid>
      </Panel>

      <!-- Ansichten -->
      <dock:DockControl x:Name="Ansichten" Grid.Row="2" Layout="{Binding Layout}" Margin="22,2,22,10" IsVisible="{Binding ZeigtArbeitsbereich}" />

      <!-- Einrichtung nach dem Öffnen einer Staffel (Rückfragen des Originals auf einer Seite) -->
      <Border Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding ZeigtEinrichtung}">
        <ui:EinrichtungAnsicht DataContext="{Binding Einrichtung}" />
      </Border>

      <!-- Startseite, solange keine Staffel geöffnet ist -->
      <ScrollViewer Grid.Row="0" Grid.RowSpan="3" IsVisible="{Binding !IstGeoeffnet}" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="960" Margin="32,64,32,32" Spacing="32">
          <StackPanel Orientation="Horizontal" Spacing="18">
            <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource Akzent}" VerticalAlignment="Center">
              <ui:Symbol Daten="{StaticResource SymbolLogo}" Farbe="White" Groesse="40" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="4">
              <TextBlock Text="Willkommen bei AndiGenerator.NET" FontSize="30" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock Text="Spielpläne für Tischtennis-Staffeln erstellen – aus den Terminwünschen in click-TT." FontSize="15" Foreground="{StaticResource Tinte2}" TextWrapping="Wrap" />
            </StackPanel>
          </StackPanel>
          <Grid ColumnDefinitions="*,20,*">
            <Button Grid.Column="0" Classes="kachel" Command="{Binding OeffnenCommand}" BorderBrush="{StaticResource Akzent}">
              <StackPanel Spacing="12">
                <ui:Symbol Daten="{StaticResource SymbolOeffnen}" Farbe="{StaticResource Akzent}" Groesse="34" HorizontalAlignment="Left" />
                <TextBlock Text="click-TT-Datei öffnen" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Tinte}" />
                <TextBlock Text="Die XML-Datei mit den Terminwünschen aus click-TT laden. Beim ersten Öffnen führt ein Assistent durch die wichtigsten Angaben." FontSize="13" Foreground="{StaticResource Tinte2}" TextWrapping="Wrap" />
                <TextBlock Text="Datei auswählen …" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="2" Classes="kachel" Command="{Binding NeuCommand}">
              <StackPanel Spacing="12">
                <ui:Symbol Daten="{StaticResource SymbolNeu}" Farbe="{StaticResource Tinte2}" Groesse="34" HorizontalAlignment="Left" />
                <TextBlock Text="Neue Staffel von Hand anlegen" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Tinte}" />
                <TextBlock Text="Ohne click-TT: Liga, Mannschaften und Termine komplett selbst eingeben." FontSize="13" Foreground="{StaticResource Tinte2}" TextWrapping="Wrap" />
                <TextBlock Text="Neue Datei anlegen …" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Akzent}" />
              </StackPanel>
            </Button>
          </Grid>
          <Border Classes="karte" Padding="14" CornerRadius="18" IsVisible="{Binding HatZuletzt}">
            <StackPanel>
              <TextBlock Text="Zuletzt geöffnet" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Tinte2}" Margin="18,6,18,8" />
              <ItemsControl ItemsSource="{Binding Zuletzt}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:Zuletztzeile">
                    <Grid ColumnDefinitions="*,Auto">
                      <Button Classes="zuletzt" Command="{Binding $parent[Window].((p:HauptfensterViewModel)DataContext).ZuletztOeffnenCommand}" CommandParameter="{Binding Pfad}" ToolTip.Tip="{Binding Pfad}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                          <ui:Symbol Daten="{StaticResource SymbolKalender}" Farbe="{StaticResource Tinte2}" Groesse="26" VerticalAlignment="Center" Margin="0,0,16,0" />
                          <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Tinte}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Ordner}" Classes="klein" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                          <TextBlock Grid.Column="2" Text="{Binding Zeit}" Classes="klein" VerticalAlignment="Center" Margin="16,0,0,0" />
                        </Grid>
                      </Button>
                      <Button Grid.Column="1" Classes="entfernen" Command="{Binding $parent[Window].((p:HauptfensterViewModel)DataContext).ZuletztEntfernenCommand}" CommandParameter="{Binding Pfad}"
                              ToolTip.Tip="Aus der Liste entfernen (die Datei selbst bleibt erhalten)">
                        <ui:Symbol Daten="{StaticResource SymbolSchliessen}" Groesse="18" />
                      </Button>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="karte" Padding="14" CornerRadius="18" IsVisible="{Binding HatBeispiele}">
            <StackPanel>
              <TextBlock Text="Beispiele zum Ausprobieren" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Tinte2}" Margin="18,6,18,2" />
              <TextBlock Text="Die Testpläne aus dem Original (Saison 2015/16) und eine Klasse mit Kompaktspieltagen. Geöffnet wird eine Kopie im Datenordner; Änderungen bleiben dort erhalten."
                         Classes="klein" TextWrapping="Wrap" Margin="18,0,18,8" />
              <ItemsControl ItemsSource="{Binding Beispiele}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="p:Beispielzeile">
                    <Button Classes="zuletzt" Command="{Binding $parent[Window].((p:HauptfensterViewModel)DataContext).BeispielOeffnenCommand}" CommandParameter="{Binding Pfad}">
                      <Grid ColumnDefinitions="Auto,*">
                        <ui:Symbol Daten="{StaticResource SymbolKalender}" Farbe="{StaticResource Akzent}" Groesse="26" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Tinte}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Beschreibung}" Classes="klein" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="Auto,*">
            <Button Classes="link" Command="{Binding UeberCommand}" Content="Über AndiGenerator.NET" />
            <TextBlock Grid.Column="1" Text="Portierung des AndiGenerators von Andreas Hofmann · GPL-3.0" Classes="klein" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
  <!-- Scheinwerfer der Führung: dunkelt kurz ab, nur das gezeigte Element bleibt hell -->
  <ui:Scheinwerfer x:Name="Licht" />
  </Panel>
</Window>
