<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:AndiGenerator.Presentation"
        x:Class="AndiGenerator.UI.Auswaertskoppeldialog"
        x:DataType="p:AuswaertskoppeldialogViewModel"
        Title="Auswärtskoppelwunsch"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
  <StackPanel Margin="24" Spacing="12">
    <Grid Classes="formular" ColumnDefinitions="120,300" RowDefinitions="Auto,Auto,Auto">
      <Grid.Styles>
        <Style Selector="Grid.formular > :is(Control)">
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Row="0" Text="Mannschaft 1:" />
      <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Partner}" SelectedItem="{Binding MannschaftA}" />
      <TextBlock Grid.Row="1" Text="Mannschaft 2:" />
      <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{Binding Partner}" SelectedItem="{Binding MannschaftB}" />
      <TextBlock Grid.Row="2" Text="Art:" />
      <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" ItemsSource="{x:Static p:AuswaertskoppeldialogViewModel.Arten}" SelectedIndex="{Binding Art}" />
    </Grid>
    <TextBlock Text="{Binding Meldung}" Classes="fehler" TextWrapping="Wrap" MaxWidth="420" HorizontalAlignment="Left" />
    <Border Classes="dialogfuss">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button x:Name="Abbrechen" Classes="gross" Content="Abbrechen" IsCancel="True" />
        <Button x:Name="Ok" Classes="gross primaer" Content="OK" IsDefault="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
