<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="using:AndiGenerator.Presentation"
        x:Class="AndiGenerator.UI.Mannschaftsdialog"
        x:DataType="p:MannschaftsdialogViewModel"
        Title="{Binding Titel}"
        SizeToContent="WidthAndHeight" CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Classes="dialog">
  <StackPanel Margin="24" Spacing="12">
    <Grid Classes="formular" ColumnDefinitions="160,240,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto">
      <Grid.Styles>
        <Style Selector="Grid.formular > :is(Control)">
          <Setter Property="Margin" Value="0,4" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hinweis">
          <Setter Property="Foreground" Value="Gray" />
          <Setter Property="Margin" Value="12,4,0,4" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Row="0" Text="Mannschaftsname" />
      <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />
      <TextBlock Grid.Row="1" Text="Mannschaftsnummer" />
      <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Nummer}" Minimum="1" Maximum="100" Increment="1" FormatString="0" />
      <TextBlock Grid.Row="1" Grid.Column="2" Classes="hinweis" Text="1., 2., 3. Mannschaft" />
      <TextBlock Grid.Row="2" Text="Mannschafts-ID" />
      <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Id}" />
      <TextBlock Grid.Row="3" Text="Vereins-ID" />
      <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding VereinsId}" />
      <TextBlock Grid.Row="4" Text="Spiellokal" />
      <ComboBox Grid.Row="4" Grid.Column="1" MinWidth="80" ItemsSource="{x:Static p:MannschaftsdialogViewModel.Spiellokale}" SelectedItem="{Binding Spiellokal}" />
      <TextBlock Grid.Row="4" Grid.Column="2" Classes="hinweis" Text="leer, falls Verein nur in einem Spiellokal spielt" />
    </Grid>
    <TextBlock Text="{Binding Meldung}" Classes="fehler" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" />
    <Border Classes="dialogfuss">
      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
        <Button x:Name="Abbrechen" Classes="gross" Content="Abbrechen" IsCancel="True" />
        <Button x:Name="Ok" Classes="gross primaer" Content="OK" IsDefault="True" />
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
