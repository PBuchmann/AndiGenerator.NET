<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AndiGenerator.Persistence\AndiGenerator.Persistence.csproj" />
    <ProjectReference Include="..\..\src\AndiGenerator.Engine\AndiGenerator.Engine.csproj" />
    <ProjectReference Include="..\..\src\AndiGenerator.Application\AndiGenerator.Application.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Anonymisierte Testdaten im Repository (tools/anonymisieren); die Originale sind privat (TESTDATEN.md Abschnitt 4). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Loesungsordner</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../..</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Testdaten</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../testdaten/clicktt</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Referenz</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)../../testdaten/referenz</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
