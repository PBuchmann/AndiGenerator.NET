<?xml version="1.0" encoding="utf-8"?>
<!--
  Einstellungen für die Testabdeckung (Microsoft Code Coverage): gemessen werden nur die Programmschichten, nicht die
  Testprojekte selbst. Visual Studio findet die Datei im Lösungsordner von selbst („runsettings-Dateien automatisch
  erkennen“, Standard); abdeckung.cmd und das CI geben sie mit settings an. bauen.cmd verwendet sie nicht.
-->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="Code Coverage">
        <Configuration>
          <CodeCoverage>
            <ModulePaths>
              <Include>
                <ModulePath>.*[\\/]AndiGenerator\.[^\\/]*\.dll$</ModulePath>
              </Include>
              <Exclude>
                <ModulePath>.*\.Tests\.dll$</ModulePath>
              </Exclude>
            </ModulePaths>
          </CodeCoverage>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
