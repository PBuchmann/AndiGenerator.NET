<Project>
  <!-- Zentrale Paketversionen. Ausgelieferte und als Bibliothek verwendete Pakete: nur MIT/Apache/BSD/LGPL (MIGRATIONSPLAN E11). -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>
  <!-- Oberfläche (MIGRATIONSPLAN E2/E3/E15), alle MIT. -->
  <ItemGroup>
    <PackageVersion Include="Avalonia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.3" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Dock.Avalonia" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Avalonia.Themes.Fluent" Version="12.1.0.6" />
    <PackageVersion Include="Dock.Model.Mvvm" Version="12.1.0.6" />
  </ItemGroup>
  <!-- PDF lesen (Bericht „Terminwünsche“ aus click-TT, nur im Baustein Import), Apache-2.0. -->
  <ItemGroup>
    <PackageVersion Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
  <!-- Löser HiGHS für die Kompaktspieltage (ganzzahlige Optimierung), MIT. -->
  <ItemGroup>
    <PackageVersion Include="Highs.Native" Version="1.15.1" />
  </ItemGroup>
  <!-- Installation und Updates über GitHub Releases (MIGRATIONSPLAN E12), MIT. Version wie das Werkzeug vpk im Release-Workflow. -->
  <ItemGroup>
    <PackageVersion Include="Velopack" Version="0.0.1298" />
  </ItemGroup>
  <!-- Steuerung durch eine KI über das Model Context Protocol (nur tools/AndiGenerator.Mcp): ModelContextProtocol Apache-2.0, Microsoft.Extensions.Hosting MIT. -->
  <ItemGroup>
    <PackageVersion Include="ModelContextProtocol" Version="2.2.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- PDF-Ausdruck des MCP-Servers ohne Avalonia: dieselbe SkiaSharp-Version, die Avalonia.Skia mitbringt (MIT). -->
    <PackageVersion Include="SkiaSharp" Version="3.119.4" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="3.119.4" />
  </ItemGroup>
  <!-- Analyzer nur zur Entwicklungszeit: nicht Teil der ausgelieferten Programme und daher von der Lizenzregel ausgenommen (E11, präzisiert 01.10.2026); Lizenzen siehe THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <GlobalPackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <GlobalPackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
    <GlobalPackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.12.1" />
  </ItemGroup>
</Project>
